{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgenticWonderwall distribution manifest",
  "description": "Describes the files shipped in an AW release package. The manifest does not copy rule bodies; it only declares file responsibilities, ownership and selection.",
  "type": "object",
  "required": ["schema_version", "distribution_version", "source_commit", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "distribution_version": { "type": "string", "minLength": 1 },
    "source_repository": { "type": "string" },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Full commit SHA of the release source."
    },
    "required": {
      "type": "array",
      "items": { "type": "string" }
    },
    "components": {
      "type": "object",
      "properties": {
        "profiles": { "type": "array", "items": { "type": "string" } },
        "adapters": { "type": "array", "items": { "type": "string" } }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "destination", "ownership"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "destination": { "type": "string", "minLength": 1 },
          "ownership": {
            "type": "string",
            "enum": ["managed-replace", "managed-block", "generated-if-missing", "project-owned"]
          },
          "required": { "type": "boolean" }
        }
      }
    }
  }
}
